# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins
WEBSITE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Canonical public media domain. Files remain stored in Wasabi.
MEDIA_CDN_URL=https://media.the961.com

# Dedicated Wasabi profile for the Media Library production bucket.
# In production, prefer AWS Secrets Manager with WASABI_MEDIA_CREDENTIALS.
WASABI_MEDIA_SECRET_NAME=WASABI_MEDIA_CREDENTIALS
WASABI_MEDIA_BUCKET=the961-media
WASABI_MEDIA_REGION=eu-south-1
WASABI_MEDIA_ENDPOINT=https://s3.eu-south-1.wasabisys.com
