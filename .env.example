# Server Configuration
PORT=5000
NODE_ENV=development
AWS_REGION=us-east-1

# Local PostgreSQL (production keeps PostgreSQL on the same Lightsail instance)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=media
PGUSER=media_app
# Never commit a real production password here.
PGPASSWORD=

# Allowed CORS Origins
WEBSITE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Canonical public media domain. Files remain stored in Wasabi.
MEDIA_CDN_URL=https://media.961.co

# AWS Secrets Manager bundle used by the Media backend.
# The secret should contain the Wasabi, Gemini, JWT, OTP, and CMS admin fields.
MEDIA_BACKEND_SECRET_NAME=961-MEDIA-BACKEND

# Optional local-development fallbacks. Production should use Secrets Manager.
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_REQUESTS=3
AUTH_SESSION_TTL=8h
JWT_ISSUER=961-media-cms
JWT_AUDIENCE=961-media-dashboard
